{
  "rewrites": [
    { "source": "/", "destination": "/dashboard.html" }
  ],
  "functions": {
    "api/dashboard-data.js": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/dashboard.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
